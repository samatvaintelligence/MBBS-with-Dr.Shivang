# Database (Supabase Postgres)
# DATABASE_URL  — pooler URL, used by the app at runtime (Vercel serverless)
# DIRECT_URL    — direct URL, used by Drizzle migrations (npm run db:push)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# Auth (NextAuth v5)
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin access (only this email can access /admin)
ADMIN_EMAIL=drshivang@gmail.com

# Phase 3: Meta Marketing API
# META_ACCESS_TOKEN=your-meta-token
# META_AD_ACCOUNT_ID=act_123456789
